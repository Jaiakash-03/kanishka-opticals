{
  "name": "@kanishka/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types, DTOs, and enums for Kanishka Opticals",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kanishka/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
