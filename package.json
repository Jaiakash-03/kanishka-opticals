{
  "name": "kanishka-opticals",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade e-commerce platform for Kanishka Opticals, Coimbatore",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .prettierignore",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @kanishka/api prisma generate",
    "db:migrate": "pnpm --filter @kanishka/api prisma migrate dev",
    "db:migrate:prod": "pnpm --filter @kanishka/api prisma migrate deploy",
    "db:studio": "pnpm --filter @kanishka/api prisma studio",
    "db:seed": "pnpm --filter @kanishka/api db:seed",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "@kanishka/eslint-config": "workspace:*",
    "@kanishka/tsconfig": "workspace:*"
  },
  "packageManager": "pnpm@9.12.0"
}
