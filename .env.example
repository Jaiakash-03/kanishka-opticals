# =============================================================================
# KANISHKA OPTICALS — ENVIRONMENT VARIABLES REFERENCE
# Copy this file to .env (for local dev) and fill in real values.
# NEVER commit .env to Git. Only .env.example is committed.
# =============================================================================

# ── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                        # development | staging | production
PORT=3001                                   # NestJS API port
API_URL=http://localhost:3001               # Public API base URL
WEB_URL=http://localhost:3000               # Public web app URL
API_PREFIX=/api/v1

# ── SECURITY ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex  # openssl rand -hex 32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_hex
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=replace_with_32_char_random_hex
ADMIN_2FA_APP_NAME=KanishkaOpticals

# ── DATABASE (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://kanishka_user:kanishka_pass@localhost:5432/kanishka_opticals?schema=public
DATABASE_SHADOW_URL=postgresql://kanishka_user:kanishka_pass@localhost:5432/kanishka_shadow?schema=public
# For read replica (production only):
# DATABASE_READ_URL=postgresql://user:pass@read-replica-host:5432/kanishka_opticals

# ── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false                             # Set true in production
# REDIS_PASSWORD=replace_in_production

# ── MEILISEARCH ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=replace_with_meilisearch_master_key

# ── STORAGE (AWS S3) ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
AWS_S3_BUCKET=kanishka-opticals-uploads
AWS_S3_BUCKET_PRIVATE=kanishka-opticals-prescriptions  # Private; pre-signed URLs only
CDN_URL=https://cdn.kanishkaopticals.in    # Cloudflare CDN or CloudFront

# ── RAZORPAY ─────────────────────────────────────────────────────────────────
# Use TEST keys during development; switch to LIVE keys before go-live
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ── EMAIL (SendGrid or AWS SES) ───────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid                     # sendgrid | ses | smtp
SENDGRID_API_KEY=replace_with_sendgrid_key
EMAIL_FROM=noreply@kanishkaopticals.in
EMAIL_FROM_NAME=Kanishka Opticals
# For SMTP fallback:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── SMS / OTP (MSG91) ─────────────────────────────────────────────────────────
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_SENDER_ID=KNSHKA
MSG91_OTP_TEMPLATE_ID=replace_with_template_id
MSG91_ORDER_TEMPLATE_ID=replace_with_template_id

# ── BULLMQ (Queue) ────────────────────────────────────────────────────────────
# Uses same Redis instance; configure separately if needed
BULL_REDIS_URL=redis://localhost:6379
BULL_BOARD_USERNAME=admin                   # BullMQ dashboard auth
BULL_BOARD_PASSWORD=replace_in_production

# ── STORE DETAILS ─────────────────────────────────────────────────────────────
STORE_NAME="Kanishka Opticals"
STORE_CITY=Coimbatore
STORE_STATE="Tamil Nadu"
STORE_COUNTRY=India
STORE_GST_NUMBER=PLACEHOLDER_GST            # Update before go-live
STORE_SUPPORT_EMAIL=support@kanishkaopticals.in
STORE_SUPPORT_PHONE=+91-XXXXXXXXXX

# ── RATE LIMITING ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000                          # ms
THROTTLE_LIMIT=100                          # requests per TTL per IP
AUTH_THROTTLE_LIMIT=5                       # Stricter limit for auth endpoints

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://kanishkaopticals.in,https://www.kanishkaopticals.in

# ── MONITORING ────────────────────────────────────────────────────────────────
SENTRY_DSN=                                 # Add Sentry DSN after account creation
SENTRY_ENVIRONMENT=development

# ── FEATURE FLAGS (overrides DB values for local testing) ────────────────────
FLAG_LENS_WIZARD=false                      # Phase 2: full lens selection wizard
FLAG_WISHLIST=false                         # Phase 2
FLAG_REVIEWS=false                          # Phase 2
FLAG_WHATSAPP_NOTIFY=false                  # Phase 2
FLAG_VIRTUAL_TRYON=false                    # Phase 3

# ── NEXT.JS (apps/web — prefix with NEXT_PUBLIC_ to expose to browser) ────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CDN_URL=https://cdn.kanishkaopticals.in
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=replace_with_search_only_key
NEXT_PUBLIC_STORE_NAME="Kanishka Opticals"
NEXT_PUBLIC_GA_ID=                          # Google Analytics ID (after account setup)
NEXT_PUBLIC_SENTRY_DSN=
